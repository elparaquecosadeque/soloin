{
  "name": "soloin",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng build soloin-lib && ng serve soloin",
    "build": "ng build soloin-lib && ng build soloin",
    "build:lib": "ng build soloin-lib",
    "build:gh-pages": "ng build soloin-lib && ng build soloin --base-href /soloin/",
    "watch": "ng build soloin-lib && ng build soloin --watch --configuration development",
    "test": "ng test soloin-lib --watch=false"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/elparaquecosadeque/soloin"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
